<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Slottr.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Slottr.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Slottr.Button.Tonale" parent="Widget.Material3.Button.TonalButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Slottr.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">18dp</item>
    </style>

    <style name="Widget.Slottr.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/primaryContainer</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Widget.Slottr.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/textSecondary</item>
        <item name="boxStrokeColor">@color/outlineVariant</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="android:textColorHint">@color/textSecondary</item>
    </style>

    <style name="Widget.Slottr.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/surfaceVariant</item>
        <item name="chipStrokeColor">@color/outlineVariant</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/onSurface</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">40dp</item>
    </style>

    <style name="Widget.Slottr.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="tint">@color/onPrimary</item>
    </style>

    <style name="Widget.Slottr.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.Slottr.NavIndicator</item>
    </style>

    <style name="Widget.Slottr.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primaryContainer</item>
    </style>

    <style name="Widget.Slottr.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/textPrimary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Slottr.SectionTitle</item>
    </style>
</resources>